# ── Scraper ─────────────────────────────────────────────────────────────────────
# Credentials for manodienynas.lt
# Note: The portal uses PHPSESSID which expires after ~1 hour.
# The scraper handles this by performing a fresh login on every run —
# never store or reuse a session cookie. Always use username + password here.
PORTAL_URL=https://www.manodienynas.lt
PORTAL_USERNAME=
PORTAL_PASSWORD=

# ── Supabase (Web App) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only, never expose to client

# ── Notion ───────────────────────────────────────────────────────────────────────
# Get from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx
# The database ID is in the page URL: notion.so/workspace/THIS_PART?v=...
NOTION_DATABASE_ID=your_database_id_here
# Path to grades.json relative to the notion.py script
GRADES_JSON_PATH=../../scraper/grades.json

# ── Google ───────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# ── Apple Calendar — no keys needed ─────────────────────────────────────────────
# .ics file is generated locally; no API credentials required.

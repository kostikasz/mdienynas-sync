# Simplified web-app environment
# Generate long secrets with:
#   openssl rand -base64 32
#
# Use examples for non-secrets and fill real values locally.

APP_PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://mdienynas:changeme@app-db:5432/mdienynas

# Secret material: generate a fresh value before deployment.
# Example: openssl rand -base64 32
SESSION_SECRET=

# Bootstrap admin identity. Not a secret, but keep it consistent with your inbox.
ADMIN_EMAIL=admin@example.com

# Cloudflare Turnstile
# Site key is public; secret key must stay server-side.
TURNSTILE_SITE_KEY=
# Compatibility alias for old env files. Prefer TURNSTILE_SITE_KEY going forward.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP
# AWS SES SMTP credentials
# Example host: email-smtp.us-east-1.amazonaws.com
# Generate SMTP user/pass in AWS SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
